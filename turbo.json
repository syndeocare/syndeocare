{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_CORS_ORIGINS",
    "API_DOCS_PATH",
    "API_PUBLIC_URL",
    "AUTH_AUDIENCE",
    "AUTH_CLIENT_ID",
    "ENABLE_DEV_AUTH_BYPASS",
    "AUTH_ISSUER_URL",
    "AUTH_JWKS_URI",
    "AUTH_MODE",
    "AUTH_REALM",
    "DATABASE_URL",
    "HOST",
    "INTERNAL_SERVICE_TOKEN",
    "KEYCLOAK_ADMIN_PASSWORD",
    "KEYCLOAK_ADMIN_REALM",
    "KEYCLOAK_ADMIN_USERNAME",
    "KEYCLOAK_BASE_URL",
    "KEYCLOAK_PUBLIC_CLIENT_ID",
    "KEYCLOAK_REALM",
    "LOG_LEVEL",
    "NATS_URL",
    "NODE_ENV",
    "NEXT_PUBLIC_ANDROID_APP_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_SITE_BASE_PATH",
    "NEXT_PUBLIC_DOCS_URL",
    "PORT",
    "SERVICE_CLINICS_URL",
    "SERVICE_IDENTITY_URL",
    "SERVICE_NOTIFICATIONS_URL",
    "SERVICE_PLATFORM_API_URL",
    "SERVICE_PROFILES_URL",
    "SERVICE_SCHEDULING_URL",
    "SERVICE_INSTANCE_NAME",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_TEST_EMAIL",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_ENDPOINT",
    "STORAGE_FORCE_PATH_STYLE",
    "STORAGE_PRIVATE_BUCKET",
    "STORAGE_PUBLIC_BASE_URL",
    "STORAGE_PUBLIC_BUCKET",
    "STORAGE_REGION",
    "STORAGE_SECRET_ACCESS_KEY",
    "STORAGE_UPLOAD_URL_TTL_SECONDS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
