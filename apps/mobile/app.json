{
  "expo": {
    "name": "SyndeoCare",
    "slug": "syndeocareapp-kwuout9l1nnlql9sziyun",
    "owner": "syndeocareplatform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "syndeocare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#663C6D"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a8d5437c-5cd2-42aa-94e3-8625034cca65"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.syndeocare.mobile"
    },
    "android": {
      "package": "ai.syndeocare.mobile",
      "permissions": [
        "NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
