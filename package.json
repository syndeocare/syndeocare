{
  "name": "syndeocare",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "pnpm --filter web build",
    "build:services": "turbo run build --filter='./services/*'",
    "db:migrate": "pnpm --filter @repo/persistence db:migrate",
    "db:seed": "pnpm --filter @repo/persistence db:seed",
    "storage:bootstrap": "pnpm --filter @repo/storage storage:bootstrap",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "lint:staged": "lint-staged",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "clean": "rimraf .turbo apps/*/.next apps/*/dist packages/*/dist services/*/dist",
    "validate": "pnpm format:check && pnpm lint && pnpm check-types",
    "validate:ci": "pnpm validate && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.14",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "20.20.2",
    "pnpm": "9.0.0"
  },
  "volta": {
    "node": "20.20.2",
    "pnpm": "9.0.0"
  }
}
